<h1>Posts</h1>
<% if user_signed_in? %>
  <%= link_to "Sign out", destroy_user_session_path, data: {turbo_method: :delete, turbo_confirm: 'Are you sure?'} %>
<% end %>

<%= link_to "New post", new_post_url %>

<ul>
  <% @posts.each do |post| %>
    <li>
      <p><%= post.title %></p>
      <% if user_signed_in? %>
        <p>By: <%= post.user.name %></p>
      <% end %>
    </li>
  <% end %>
</ul>