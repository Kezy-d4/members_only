<h1>New post</h1>

<%= form_with model: @post do |form| %>
  <p>
    <%= form.label :title %>
    <%= form.text_field :title, required: true, maxlength: 150 %>
  </p>
  <p>
    <%= form.label :body %>
    <%= form.text_area :body, required: true, maxlength: 2500 %>
  </p>
  <p>
    <%= form.submit %>
  </p>
<% end %>

<%= link_to "Cancel", posts_url %>
